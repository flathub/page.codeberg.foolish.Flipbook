{
    "id": "page.codeberg.foolish.Flipbook",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "flipbook",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "modules": [
    	{
	      "name": "libportal",
	      "buildsystem": "meson",
	      "builddir": true,
	      "config-opts": [
		"-Dbackend-gtk4=enabled",
		"-Ddocs=false"
	      ],
	      "sources": [
		{
		  "type": "git",
		  "url": "https://github.com/flatpak/libportal.git",
		  "commit" : "c23024018c8eb076549a1517fcb2d7f80d3e2ed5",
		  "tag" : "0.10.0"
		}
	      ]
	 },
        {
            "name": "flipbook",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Dprofile=default"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/foolish/Flipbook.git",
                    "tag": "0.31",					
                    "commit": "9fd93a04877520f793775b1667957e8e394edbb8"
                }
            ]
        }
    ]
}
